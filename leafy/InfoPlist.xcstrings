            "value" : "MyLeafy 学习资料"
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "Privacy - Calendars Full Access Usage Description",
      "localizations" : {
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyLeafy needs calendar access to export your timetable to Calendar and update previously exported classes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyLeafy 需要访问日历，以便把课表导出到本地日历，并在重复导出时更新已写入的课程。"
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyLeafy needs camera access so you can take and save photos in local notes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyLeafy 需要使用相机，以便你拍摄并保存本机随记图片。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "localizations" : {
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your location is used to show weather information for your current area and provide timetable-based travel suggestions."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于获取你所在地区的天气信息，并结合当天课表提供出行建议。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "localizations" : {
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyLeafy uses the microphone for on-device speech transcription and recordings you choose to save as local notes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于在设备端转写语音，并保存你主动创建的本机录音随记。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "localizations" : {
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyLeafy needs permission to save feedback images and cards you create to Photos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyLeafy 需要将反馈图片和你生成的图文卡片保存到相册。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "localizations" : {
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyLeafy needs photo access so you can choose a community profile picture and images for posts."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyLeafy 需要访问照片，以便你选择社区头像和发帖图片。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Privacy - Speech Recognition Usage Description",
      "localizations" : {
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyLeafy uses on-device speech recognition to turn your voice into text for local notes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于在设备端将语音转写为本机随记文字。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
