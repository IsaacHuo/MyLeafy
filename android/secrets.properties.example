# MyLeafy Android 构建配置（本文件不提交 Git）
#
# 与 iOS 端 Config/Leafy.local.xcconfig 等价。仅允许填写公开的 Supabase
# project URL 与 publishable/anon key；严禁放入 service_role key 或任何私密凭据。
#
# 复制示例：cp secrets.properties.example secrets.properties
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxx
