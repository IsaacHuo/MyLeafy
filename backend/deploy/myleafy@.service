[Unit]
Description=MyLeafy backend (%i)
After=network-online.target
Wants=network-online.target

[Service]
User=myleafy
Group=myleafy
EnvironmentFile=/etc/myleafy/%i.env
WorkingDirectory=/opt/myleafy/%i/current/backend
ExecStart=/usr/local/bin/node dist/server.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/myleafy/%i
MemoryMax=768M

[Install]
WantedBy=multi-user.target
