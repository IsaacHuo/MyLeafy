{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leafy",
  "pages_build_output_dir": "dist",
  "compatibility_date": "2026-09-05",
  "services": [
    {"binding": "MYLEAFY_ADMIN_API", "service": "myleafy-api-production", "entrypoint": "AdminAPI"},
    {"binding": "MYLEAFY_PUBLIC_API", "service": "myleafy-api-production"}
  ]
}
