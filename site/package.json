{
  "name": "leafy-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:pages": "npm run build && wrangler pages dev dist --compatibility-date=2026-07-10",
    "build": "npm run typecheck && vite build && npm run check:pages",
    "check:pages": "wrangler pages functions build --outdir .wrangler/functions --compatibility-date=2026-09-05",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@paper-design/shaders-react": "^0.0.76",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-table": "^8.21.3",
    "@vitejs/plugin-react": "^6.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "6.1.0",
    "framer-motion": "^12.23.24",
    "lucide-react": "^1.14.0",
    "radix-ui": "^1.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.90.0",
    "react-router-dom": "7.18.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "vite": "^8.0.11"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "jsdom": "29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.3",
    "vitest": "4.1.10",
    "wrangler": "4.110.0"
  }
}
